DATABASE_URL="postgresql://postgres:postgres@localhost:5434/hypothesis_atlas?schema=public"
REDIS_URL="redis://localhost:6379"
GROQ_API_KEY="your_groq_api_key_here"
ANTHROPIC_API_KEY="sk-ant-..."   # Required for Paper Compare Mode

# NextAuth (see src/lib/auth.ts) — both required for real login/signup to work.
NEXTAUTH_SECRET="generate with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"   # the deployed URL in production

# Leave unset for self-hosted/anonymous use (the default). Set to "true" only
# on the hosted deployment to require sign-in before starting new research —
# see src/lib/authConfig.ts.
# REQUIRE_AUTH="true"

# #91: which edition this deployment is. "self-hosted" (the open-source
# default) doesn't prompt users for their own model key when the keys above
# are set; "hosted" (our deployment) always offers it. Unset, it follows
# REQUIRE_AUTH: "true" → hosted, otherwise self-hosted.
# ATLAS_EDITION="self-hosted"

# ── Optional: each one switches on an extra feature (see README → Configuration) ──
# OPENAI_API_KEY="sk-..."                 # independent critic in Bold Idea explorations
# RESEND_API_KEY="re_..."                 # weekly digests + password-reset emails
# EMAIL_FROM="Hypothesis Atlas <hello@yourdomain.com>"   # sender for those emails
# NEXT_PUBLIC_APP_URL="http://localhost:3000"            # base URL in email links
# CRON_SECRET="..."                       # protects /api/cron/weekly-digest
# NEO4J_URI="neo4j+s://..."               # Neo4j paper graph behind the Paper Map
# NEO4J_USERNAME="neo4j"
# NEO4J_PASSWORD="..."
# NEO4J_DATABASE="neo4j"
# REVIEW_NLI_ENDPOINT="https://..."       # NLI service for claim grounding
# REVIEW_NLI_AUTH_TOKEN="..."
# REVIEW_NLI_MODEL="deberta-v3-large-mnli"
