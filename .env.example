DATABASE_URL="postgresql://postgres:postgres@localhost:5434/hypothesis_atlas?schema=public"
REDIS_URL="redis://localhost:6379"
GROQ_API_KEY="your_groq_api_key_here"
ANTHROPIC_API_KEY="sk-ant-..."   # Required for Paper Compare Mode

# NextAuth (see src/lib/auth.ts) — both required for real login/signup to work.
NEXTAUTH_SECRET="generate with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"   # the deployed URL in production

# Leave unset for self-hosted/anonymous use (the default). Set to "true" only
# on the hosted deployment to require sign-in before starting new research —
# see src/lib/authConfig.ts.
# REQUIRE_AUTH="true"
