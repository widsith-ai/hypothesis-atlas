generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Job {
  id          String   @id @default(cuid())
  topicQuery  String
  status      String   @default("pending")
  rootNodeId  String?
  // Nullable and unenforced on read/write access for now — #36/V3.6 phase 2.
  // Stamped from the session when one exists (POST /api/jobs), but anonymous
  // creation still works (no auth-required gate yet, that's phase 3) and no
  // existing route checks it (that's phase 4's ownership retrofit). This is
  // just "remember who made it" for now, not an access-control boundary.
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  sources       Source[]
  nodes         Node[]
  events        ProgressEvent[]
  notebookPages NotebookPage[]
  messages      NotebookMessage[]
  candidates    CandidateTopic[]
  top3Ideas     Top3Ideas?

  @@index([status])
  @@index([createdAt])
  @@index([userId])
}

model ProgressEvent {
  id        String   @id @default(cuid())
  jobId     String
  stage     String
  status    String
  message   String
  count     Int?
  timestamp BigInt
  createdAt DateTime @default(now())
  
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  @@index([jobId])
  @@index([createdAt])
}

model Source {
  id              String   @id @default(cuid())
  jobId           String
  type            String
  title           String
  url             String?
  publishedAt     DateTime?
  authorsJson     String?
  venue           String?
  snippet         String?
  externalId      String?
  reliabilityTier String
  createdAt       DateTime @default(now())
  
  job             Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  nodeSources     NodeSource[]
  entitySources   EntitySource[]
  
  @@index([jobId])
  @@index([type])
  @@index([reliabilityTier])
}

model Node {
  id                  String   @id @default(cuid())
  jobId               String
  parentId            String?
  label               String
  summary             String   @db.Text
  methodsJson         String?  @db.Text
  findingsJson        String?  @db.Text
  disagreementsJson   String?  @db.Text
  openProblemsJson    String?  @db.Text
  depth               Int      @default(0)
  createdAt           DateTime @default(now())
  
  job                 Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  parent              Node?    @relation("NodeChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children            Node[]   @relation("NodeChildren")
  nodeSources         NodeSource[]
  
  @@index([jobId])
  @@index([parentId])
}

model NodeSource {
  id        String   @id @default(cuid())
  nodeId    String
  sourceId  String
  role      String
  createdAt DateTime @default(now())
  
  node      Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  source    Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  
  @@unique([nodeId, sourceId])
  @@index([nodeId])
  @@index([sourceId])
}

model NotebookPage {
  id        String   @id @default(cuid())
  jobId     String
  title     String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  messages  NotebookMessage[]
  
  @@index([jobId])
  @@index([createdAt])
}

model NotebookMessage {
  id            String   @id @default(cuid())
  jobId         String
  pageId        String?
  role          String   // 'user' | 'assistant'
  content       String   @db.Text
  citationsJson String?  @db.Text
  createdAt     DateTime @default(now())
  
  job           Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  page          NotebookPage? @relation(fields: [pageId], references: [id], onDelete: Cascade)
  
  @@index([jobId])
  @@index([pageId])
  @@index([createdAt])
}

model CandidateTopic {
  id            String   @id @default(cuid())
  jobId         String
  label         String
  status        String   @default("active") // 'active' | 'archived' | 'selected'
  evidenceJson  String?  @db.Text
  score         Float?
  createdAt     DateTime @default(now())
  
  job           Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  @@index([jobId])
  @@index([status])
  @@index([createdAt])
}

model Top3Ideas {
  id          String   @id @default(cuid())
  jobId       String   @unique
  generatedAt DateTime @default(now())
  ideasJson   String   @db.Text
  traceJson   String?  @db.Text

  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

// "Try Something Bold" — an unconstrained free-text on-ramp into the same
// evidence-mapping pipeline the word-cloud flow uses (see /api/jobs). jobId
// is provenance only, not an enforced FK, matching Experiment.jobId's
// pattern elsewhere in this schema.
model BoldIdea {
  id             String   @id @default(cuid())
  text           String   @db.Text // the original freeform idea, verbatim
  tagsJson       String   @db.Text // JSON array of subject tags from the tagger agent
  jobId          String? // the Job this was turned into
  agentTraceJson String?  @db.Text // full multi-agent trace (Explorer/Literature/Critic) — see lib/boldIdeaAgents.ts
  experimentJson String?  @db.Text // the second-phase experiment design for one chosen candidate direction — see lib/boldIdeaAgents.ts generateExperiment()
  knowledgeJson  String?  @db.Text // JSON array of user-highlighted chat snippets saved as knowledge — see /api/bold-ideas/[id]/knowledge
  // Same #36/V3.6 phase-2 treatment as Job.userId — nullable, unenforced,
  // just records who made it.
  userId         String?
  createdAt      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
}

model PaperSubscription {
  id           String   @id @default(cuid())
  email        String
  topic        String
  frequency    Int      @default(10)
  deliveryTime String   @default("09:00")
  unsubToken   String   @unique @default(cuid())
  createdAt    DateTime @default(now())

  @@index([email])
  @@index([topic])
}

// V3 — Persistent cross-run research graph (single source of truth)

model GraphEntity {
  id           String   @id @default(cuid())
  type         String   // 'topic' | 'hypothesis' | 'method' | 'evidence' | 'gap' | 'note' | 'outcome' | 'dataset'
  label        String
  content      String?  @db.Text
  jobId        String?  // provenance: run that produced it (survives job deletion)
  origin       String   @default("system") // 'system' (synced from a run) | 'user' (manually created)
  syncKey      String?  // deterministic key for idempotent run-sync upserts — unique per workspace, not globally (see @@unique below)
  // #54/V3.0.1: isolates the graph per tenant. One workspace per signed-in
  // user (workspaceId = their user id); anonymous/self-hosted callers share
  // a single "default" workspace (see lib/graphAccess.ts) — same single-
  // tenant semantics as before accounts existed, since anonymous callers
  // can't be told apart anyway. A full Workspace model with membership is a
  // bigger feature this issue doesn't build.
  workspaceId  String   @default("default")
  // 'private' (default, only this workspace) | 'shared' (any signed-in
  // viewer) | 'public' (anyone, including anonymous). Write access (create/
  // edit/delete) is always confined to the entity's own workspace regardless
  // of visibility — only read reach widens. Nothing sets this away from the
  // default yet; that's a sharing feature, not this issue's scope.
  visibility   String   @default("private")
  metadataJson String?  @db.Text // e.g. {"noteType":"manual"} for notes
  pinned       Boolean  @default(false)
  // #55/V3.0.2: domain classification (e.g. "biology"), unset until a
  // classifier exists — just plumbing for now, settable manually.
  domain       String?
  // sha256 of (type, label, content) — lets a future supersede pass detect
  // "this record's substance actually changed" without a full diff.
  contentHash  String?
  // Bumped only if this entity's JSON shape (metadataJson etc.) changes in
  // a backwards-incompatible way; starts at 1 for every row written so far.
  schemaVersion Int     @default(1)
  // Id of the GraphEntity this one supersedes (e.g. a replicated outcome
  // superseding an earlier one) — self-referencing, not enforced as an FK
  // since the superseded row may since have been deleted/merged.
  supersedes   String?
  // Coarse "who/what wrote this": 'research-agent' for run-synced records,
  // or the creating user's id ('anonymous' when none) for manual ones. A
  // full per-agent identity (model, version, tool calls) is #58's job —
  // this is just enough to answer "human or agent, and which one."
  producer     String?
  // Verification stamps — set by lib/claimVerification.ts's verifyClaim()
  // gate for entities that went through it (evidence/outcome claims synced
  // from a run); left null for entities that were never run through the
  // gate (e.g. topics, methods, manually created notes).
  status       String? // 'grounded' | 'unsupported' | 'contradicted' | 'unavailable'
  method       String? // 'overlap' | 'nli' | 'llm_judge' | 'unavailable'
  confidence   Float?
  checkedAt    DateTime?
  verifier     String? // identifies the verification pass, e.g. "verifyClaim/v1"
  // #56/V3.0.3: presence (not a separate boolean) means this hypothesis was
  // explicitly abandoned, overriding whatever lib/outcomes.ts would otherwise
  // compute from its linked outcomes — "abandoned requires a reason".
  // Meaningless for non-hypothesis entities.
  abandonedReason String? @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  edgesFrom     GraphEdge[]    @relation("GraphEdgeFrom")
  edgesTo       GraphEdge[]    @relation("GraphEdgeTo")
  entitySources EntitySource[]

  @@unique([workspaceId, syncKey])
  @@index([type])
  @@index([jobId])
  @@index([origin])
  @@index([workspaceId])
}

model GraphEdge {
  id        String   @id @default(cuid())
  fromId    String
  toId      String
  // 'motivates' | 'supports' | 'uses_method' | 'contradicts' | 'reveals' |
  // 'related_to' | 'notes_on' | 'tests' | 'uses_dataset' | 'derived_from' |
  // 'transferred_from' | 'replicates'.
  // #55/V3.0.2: 'supports' replaced 'provides' — evidence supports a
  // hypothesis/topic, not the other way around (fromId is now the evidence).
  type      String
  jobId     String?
  origin    String   @default("system")
  // #54/V3.0.1: no separate visibility field on edges — an edge is visible
  // exactly when both its endpoint entities are (see lib/graphAccess.ts).
  // workspaceId is still stamped (matches this issue's explicit ask, and
  // speeds up own-workspace write/delete checks) even though it's derivable
  // from the endpoints.
  workspaceId String  @default("default")
  // #55/V3.0.2: same producer/verification stamps as GraphEntity, for edges
  // created by the verifyClaim() gate ('supports'/'contradicts' edges) —
  // null for edge types the gate doesn't touch (motivates, uses_method, …).
  producer   String?
  status     String?
  method     String?
  confidence Float?
  checkedAt  DateTime?
  verifier   String?
  createdAt DateTime @default(now())

  from      GraphEntity @relation("GraphEdgeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        GraphEntity @relation("GraphEdgeTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, type])
  @@index([fromId])
  @@index([toId])
  @@index([type])
  @@index([workspaceId])
}

model EntitySource {
  id        String   @id @default(cuid())
  entityId  String
  sourceId  String
  // 'supporting' (default) | 'contradicting' — #55/V3.0.2: counter-evidence
  // links now record that they contradict, instead of every link claiming
  // to support.
  role      String   @default("supporting")
  // Exact passage in the source this link is grounded on, when verifyClaim()
  // found one — null for links created without going through the gate
  // (e.g. a node's full source list before per-claim grounding existed).
  start     Int?
  end       Int?
  text      String?  @db.Text
  createdAt DateTime @default(now())

  entity    GraphEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  source    Source      @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([entityId, sourceId])
  @@index([entityId])
  @@index([sourceId])
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth) models — issue #36/V3.6, phase 1: real accounts,
// replacing AuthModal.tsx's fake setTimeout login. Account/Session/
// VerificationToken are the stock @next-auth/prisma-adapter shape (needed
// verbatim for the adapter to work); User adds `passwordHash` on top of the
// stock fields for the Credentials provider (email+password, matching the
// fields AuthModal already collects) — null for any future OAuth-only user.
//
// No `userId` on Job/Experiment/etc. yet and no auth-required gate — both
// are later phases of #36 (ownership enforcement needs every existing data
// route audited first; self-hosted anonymous usage must keep working until
// then). This phase only makes login/signup real.
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // Credentials-provider auth; null for an OAuth-only user
  // #43/V3.2: not wired to any real billing flow yet (no Stripe/payment
  // integration exists) — a plain stored field so the Billing & Usage page
  // can show a real value instead of a hardcoded UI string, ready for #34's
  // $19/month hosted tier to flip it when that lands.
  planTier      String    @default("free")
  createdAt     DateTime  @default(now())

  accounts  Account[]
  sessions  Session[]
  jobs      Job[]
  boldIdeas BoldIdea[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
